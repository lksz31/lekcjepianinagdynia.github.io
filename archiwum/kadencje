      <!-- Ciąg akordowy -->
      <div id="chord-seq-section">
        <div style="font-size:0.62rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;margin-bottom:6px;">Ciąg akordowy (przeciągnij tonacje)</div>
