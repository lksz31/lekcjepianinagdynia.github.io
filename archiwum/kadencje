<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kadencje – Łukasz Ganczarek</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ivory:#F8F4EC;--cream:#EDE8DC;--warm-black:#1A1410;--brown:#6B4F3A;
  --amber:#C8882A;--amber-light:#F0C870;--shadow:rgba(26,20,16,0.12);
  --navy:#1e3a8a;--gold:#d4af37;--border:#e2e8f0;--bg:#f8fafc;--text:#334155;
}
html{scroll-behavior:smooth}
body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;display:flex;flex-direction:column;}

/* NAV */
.site-nav{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:rgba(255,255,255,0.92);backdrop-filter:blur(10px);border:1px solid var(--border);border-radius:50px;padding:10px 30px;display:flex;gap:25px;z-index:1000;box-shadow:0 5px 20px rgba(0,0,0,0.08);font-size:0.85rem;font-weight:600;white-space:nowrap;}
.site-nav a{color:var(--navy);text-decoration:none;transition:0.3s;}
.site-nav a:hover{color:var(--gold);}
.site-nav a.nav-highlight{background:var(--navy);color:white;padding:4px 16px;border-radius:50px;font-size:0.8rem;}
.site-nav a.nav-highlight:hover{background:var(--gold);}
@media(max-width:700px){.site-nav{display:none;}}
.mobile-nav{display:none;position:fixed;bottom:0;left:0;right:0;background:rgba(255,255,255,0.97);backdrop-filter:blur(10px);border-top:1px solid var(--border);padding:8px 0 env(safe-area-inset-bottom,8px);z-index:1000;}
.mobile-nav-inner{display:flex;justify-content:space-around;align-items:center;}
.mobile-nav a{display:flex;flex-direction:column;align-items:center;text-decoration:none;color:#94a3b8;font-size:0.57rem;font-weight:600;gap:3px;transition:0.2s;flex:1;max-width:72px;}
.mobile-nav a .mn-icon{font-size:1.15rem;}
.mobile-nav a:hover,.mobile-nav a.active{color:var(--navy);}
.mobile-nav a.mn-cta{background:var(--navy);color:white!important;padding:7px 10px;border-radius:50px;flex-direction:row;gap:4px;font-size:0.65rem;max-width:none;flex:none;}
@media(max-width:700px){.mobile-nav{display:block;}body{padding-bottom:68px;}}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;align-items:center;padding:100px 16px 60px;gap:16px;}
.page-title{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4vw,2.8rem);color:var(--navy);text-align:center;}
.page-title em{color:var(--gold);font-style:italic;}
.page-sub{color:#64748b;font-size:0.88rem;text-align:center;max-width:600px;}
.badge-prealpha{display:inline-block;background:#fdf2f8;color:#86198f;border:1px solid #f5d0fe;border-radius:50px;padding:4px 14px;font-size:0.68rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;}

/* PANEL */
.ctrl-outer{background:white;border-radius:24px;border:1px solid var(--border);box-shadow:0 4px 20px rgba(0,0,0,0.06);width:100%;max-width:1060px;overflow:hidden;}
.ctrl-topbar{display:flex;align-items:center;justify-content:space-between;padding:11px 16px;border-bottom:1px solid var(--border);gap:10px;flex-wrap:wrap;}
.ctrl-topbar-title{font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#94a3b8;}
.ctrl-body{padding:14px 16px;display:flex;flex-direction:column;gap:12px;}
.ctrl-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.ctrl-lbl{font-size:0.66rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;white-space:nowrap;min-width:80px;}
.ctrl-btns{display:flex;gap:5px;flex-wrap:wrap;}
.cb{padding:5px 11px;border-radius:50px;border:2px solid var(--navy);background:white;color:var(--navy);font-weight:700;cursor:pointer;transition:0.2s;font-size:0.71rem;font-family:'Poppins',sans-serif;white-space:nowrap;}
.cb.active{background:var(--navy);color:white;}
.cb:hover:not(.active){background:#f0f7ff;}

/* KEY GRID */
.key-grid{display:flex;gap:6px;flex-wrap:wrap;}
.key-btn{padding:6px 13px;border-radius:50px;border:2px solid var(--border);background:white;font-family:'Poppins',sans-serif;font-weight:700;font-size:0.78rem;cursor:pointer;transition:0.2s;color:var(--text);white-space:nowrap;position:relative;overflow:hidden;}
.key-btn::before{content:attr(data-count);position:absolute;left:4px;bottom:0px;font-size:1.5rem;font-weight:900;opacity:0.16;line-height:1;pointer-events:none;color:inherit;font-family:'Poppins',sans-serif;}
.key-btn::after{content:attr(data-sign);position:absolute;right:3px;bottom:-2px;font-size:1.5rem;font-weight:900;opacity:0.16;line-height:1;pointer-events:none;color:inherit;font-family:'serif';}
.key-btn:hover{border-color:var(--navy);background:#f0f7ff;}
.key-btn.active{border-color:var(--navy);background:var(--navy);color:white;}
.key-btn.active::before,.key-btn.active::after{opacity:0.14;color:white;}
.key-btn.sharps{border-color:#c8882a;}
.key-btn.sharps.active{background:#c8882a;border-color:#c8882a;color:white;}
.key-btn.flats{border-color:#2e7d52;}
.key-btn.flats.active{background:#2e7d32;border-color:#2e7d52;color:white;}
/* Scrollbar ukryty */
#key-grid-dur::-webkit-scrollbar,#key-grid-moll::-webkit-scrollbar{display:none;}
#key-grid-dur,#key-grid-moll{scrollbar-width:none;-ms-overflow-style:none;cursor:grab;}
#key-grid-dur:active,#key-grid-moll:active{cursor:grabbing;}

/* FUNCTION BUILDER */
.func-builder{background:white;border-radius:24px;border:1px solid var(--border);box-shadow:0 4px 20px rgba(0,0,0,0.06);width:100%;max-width:1060px;overflow:hidden;}
.func-topbar{display:flex;align-items:center;justify-content:space-between;padding:11px 16px;border-bottom:1px solid var(--border);gap:10px;flex-wrap:wrap;}
.func-topbar-title{font-size:0.72rem;font-weight:800;text-transform:uppercase;letter-spacing:0.1em;color:#94a3b8;}
.func-body{padding:14px 16px;display:flex;flex-direction:column;gap:12px;}
.func-btns-row{display:flex;gap:7px;flex-wrap:wrap;align-items:center;}
.fb{padding:8px 18px;border-radius:50px;border:2px solid;font-family:'Playfair Display',serif;font-size:1.05rem;font-weight:700;cursor:pointer;transition:all 0.15s;}
.fb.T{background:#FFF3E0;border-color:#C8882A;color:#C8882A;}
.fb.T:hover{background:#C8882A;color:white;}
.fb.S{background:#E8F5E9;border-color:#2E7D52;color:#2E7D52;}
.fb.S:hover{background:#2E7D52;color:white;}
.fb.D{background:#E8EAF6;border-color:#3949AB;color:#3949AB;}
.fb.D:hover{background:#3949AB;color:white;}
.fb.t{background:#FCE4EC;border-color:#880E4F;color:#880E4F;}
.fb.t:hover{background:#880E4F;color:white;}
.fb.s{background:#E0F2F1;border-color:#004D40;color:#004D40;}
.fb.s:hover{background:#004D40;color:white;}
.fb.d{background:#EDE7F6;border-color:#4527A0;color:#4527A0;}
.fb.d:hover{background:#4527A0;color:white;}
.fb.rm{background:#fdf2f8;border-color:#c026d3;color:#c026d3;font-family:'Poppins',sans-serif;font-size:0.78rem;}
.fb.rm:hover{background:#c026d3;color:white;}
.fb-sep{width:1px;height:28px;background:var(--border);margin:0 4px;}

/* SEQUENCE DISPLAY */
.seq-wrap{min-height:44px;background:#f8fafc;border-radius:12px;border:1px solid var(--border);padding:8px 12px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.seq-chip{padding:5px 13px;border-radius:50px;font-weight:700;font-size:0.9rem;font-family:'Playfair Display',serif;cursor:pointer;transition:0.15s;}
.seq-chip:hover{filter:brightness(0.9);}
.seq-chip.T{background:#FFF3E0;color:#C8882A;border:1.5px solid #C8882A;}
.seq-chip.S{background:#E8F5E9;color:#2E7D52;border:1.5px solid #2E7D52;}
.seq-chip.D{background:#E8EAF6;color:#3949AB;border:1.5px solid #3949AB;}
.seq-chip.t{background:#FCE4EC;color:#880E4F;border:1.5px solid #880E4F;}
.seq-chip.s{background:#E0F2F1;color:#004D40;border:1.5px solid #004D40;}
.seq-chip.d{background:#EDE7F6;color:#4527A0;border:1.5px solid #4527A0;}
.seq-arrow{color:#94a3b8;font-size:1rem;}
.seq-empty{color:#94a3b8;font-size:0.85rem;font-style:italic;}

/* GENERATE BUTTON */
.gen-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
.btn-gen{padding:10px 28px;border-radius:50px;border:none;background:var(--navy);color:white;font-family:'Poppins',sans-serif;font-size:0.9rem;font-weight:700;cursor:pointer;transition:0.2s;box-shadow:0 4px 16px rgba(30,58,138,0.25);}
.btn-gen:hover{background:var(--gold);color:#1a1a2e;transform:translateY(-1px);}
.btn-clear{padding:10px 20px;border-radius:50px;border:1.5px solid var(--border);background:white;font-family:'Poppins',sans-serif;font-size:0.9rem;cursor:pointer;color:#64748b;transition:0.2s;}
.btn-clear:hover{border-color:var(--navy);color:var(--navy);}

/* STAFF CARD */
.staff-card{background:white;border-radius:24px;border:1px solid var(--border);box-shadow:0 4px 20px rgba(0,0,0,0.06);width:100%;max-width:1060px;padding:20px 16px;}
.svg-scroll{overflow-x:auto;width:100%;-webkit-overflow-scrolling:touch;}
#main-svg{display:block;width:100%;height:auto;max-width:100%;}
.info-row{font-size:0.78rem;color:#64748b;margin-top:10px;min-height:1.2em;text-align:center;line-height:1.7;}
.err-row{font-size:0.78rem;color:#dc2626;margin-top:4px;min-height:1.2em;text-align:center;}

/* LEGEND */
.legend-row{display:flex;gap:14px;flex-wrap:wrap;justify-content:center;margin-top:10px;}
.leg{display:flex;align-items:center;gap:5px;font-size:0.75rem;color:#64748b;}
.leg-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}

.seq-row{display:flex;gap:8px;align-items:stretch;width:100%;}
.seq-main{flex:1;min-width:0;}
.trash-zone{min-width:56px;width:56px;flex-shrink:0;border-radius:14px;border:2px dashed #f87171;background:#fff5f5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;transition:all 0.2s;font-size:1.3rem;padding:6px 2px;}
.trash-zone.over{background:#fee2e2;border-color:#dc2626;transform:scale(1.04);}
.trash-zone span{font-size:0.56rem;font-weight:700;color:#f87171;text-transform:uppercase;letter-spacing:0.05em;}
.rand-btn{min-width:56px;width:56px;flex-shrink:0;border-radius:14px;border:2px solid var(--gold);background:#fef9e7;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;transition:all 0.2s;font-size:1.3rem;padding:6px 2px;}
.rand-btn:hover{background:var(--gold);}
.rand-btn span{font-size:0.56rem;font-weight:700;color:#92710a;text-transform:uppercase;letter-spacing:0.05em;}
.rand-btn:hover span{color:white;}
.seq-chip[draggable]{cursor:grab;user-select:none;}
.seq-chip[draggable]:active{cursor:grabbing;opacity:0.7;}
.fb[draggable]{cursor:grab;}
.moll-sup{font-size:0.65em;vertical-align:super;margin-right:1px;font-family:'Poppins',sans-serif;}
.key-drop-over{background:#e0f2fe!important;border-color:var(--navy)!important;transform:scale(1.04);}
</style>
</head>
