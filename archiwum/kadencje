      <span class="func-topbar-title" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        🎼 Ciąg funkcyjny —
        <span id="key-drop-zone"
          ondragover="event.preventDefault();this.classList.add('key-drop-over')"
          ondragleave="this.classList.remove('key-drop-over')"
          ondrop="dropKeyToChangeKey(event)"
          title="Przeciągnij tonację tutaj by zmienić tonację"
          style="display:inline-flex;align-items:center;gap:5px;background:#f1f5f9;border:2px dashed #cbd5e1;border-radius:8px;padding:3px 10px;cursor:copy;min-width:80px;transition:all 0.2s;">
          <span style="font-size:0.7rem;color:#94a3b8;">🎵</span>
          <span id="topbar-key" style="color:var(--navy);font-style:italic;font-size:0.85rem;">C dur</span>
        </span>
      </span>
      <span style="font-size:0.72rem;color:#94a3b8;" id="seq-count">0 / 10</span>
    </div>
    <div class="func-body">
      <!-- Ciąg funkcyjny (T S D + moll) -->
      <div id="func-seq-section">
        <div style="font-size:0.62rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;margin-bottom:6px;">Ciąg funkcyjny</div>
