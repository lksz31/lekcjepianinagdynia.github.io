        <span class="ctrl-lbl">Nazwy nut</span>
        <div class="ctrl-btns">
          <button class="cb active" id="cb-lang-pl" onclick="setNoteLang('pl')">Polska</button>
          <button class="cb" id="cb-lang-en" onclick="setNoteLang('en')">Angielska</button>
        </div>
      </div>
      <!-- Tonacja — koło kwintowe: bemole←  C  →krzyżyki -->
      <div class="ctrl-row" style="align-items:flex-start;">
        <span class="ctrl-lbl" style="padding-top:6px;">Tonacja</span>
        <div style="display:flex;flex-direction:column;gap:6px;flex:1;min-width:0;">
