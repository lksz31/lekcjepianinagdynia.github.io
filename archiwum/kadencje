          <div class="rand-btn" onclick="randomizeSeq()" title="Losuj ciąg funkcyjny">🎲<span>Losuj</span></div>
        </div>
      </div>
      <!-- Separator -->
      <div style="display:flex;align-items:center;gap:10px;margin:6px 0;">
        <div style="flex:1;height:1px;background:var(--border);"></div>
        <span style="font-size:0.7rem;color:#94a3b8;font-weight:700;">lub</span>
