          <div class="rand-btn" onclick="randomizeChordSeq()" title="Losuj ciąg akordowy">🎲<span>Losuj</span></div>
        </div>
      </div>
      <div class="gen-row" style="margin-top:10px;">
        <button class="btn-gen" onclick="generate()">▶ Generuj prowadzenie głosów</button>
        <button class="btn-clear" onclick="clearAll()">Wyczyść wszystko</button>
      </div>
    </div>
  </div>

  <!-- Pięciolinia wynikowa -->
  <div class="staff-card" id="staff-card" style="display:none;">
    <div class="svg-scroll"><svg id="main-svg" style="overflow:visible;"></svg></div>
    <div class="info-row" id="info-row"></div>
    <div class="err-row" id="err-row"></div>
    <div class="legend-row">
      <div class="leg"><div class="leg-dot" style="background:#7B4F9A"></div>Sopran (↑ wiolinowy)</div>
      <div class="leg"><div class="leg-dot" style="background:#C8882A"></div>Alt (↓ wiolinowy)</div>
      <div class="leg"><div class="leg-dot" style="background:#2E7D52"></div>Tenor (↑ basowy)</div>
      <div class="leg"><div class="leg-dot" style="background:#5B6FA6"></div>Bas (↓ basowy)</div>
    </div>
  </div>
