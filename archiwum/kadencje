// GENEROWANIE VOICINGÓW
// ═══════════════════════════════════════════════════
function tryGenerateVoicings(key, lay, startPos) {
  const chord0 = buildChord(key, seq[0]);
  const voicings = [buildVoicing(chord0, lay, startPos)];
  for(let i=1; i<seq.length; i++) {
    const chord = buildChord(key, seq[i]);
    voicings.push(leadVoices(voicings[i-1], chord, lay));
  }
  return voicings;
}

function generateVoicings() {
  if(seq.length < 1) return [];
  const key = currentKey;
  const lay = currentLayout;
  const startPositions = ['kwinta','tercja','pryma','kwinta','tercja'];
  let best = null, bestErrors = 9999;
  for(const sp of startPositions) {
    const v = tryGenerateVoicings(key, lay, sp);
    const errs = checkErrors(v).length + countParallelErrors(v);
    if(errs < bestErrors) { bestErrors = errs; best = v; }
    if(bestErrors === 0) break;
  }
  return best || tryGenerateVoicings(key, lay, 'kwinta');
}

function countParallelErrors(voicings) {
  let count = 0;
  for(let i=1; i<voicings.length; i++) {
    if(hasParallels(voicings[i-1], voicings[i])) count++;
    if(allSameDir(voicings[i-1], voicings[i])) count++;
    if(hasAugmentedLeap(voicings[i-1], voicings[i])) count++;
  }
  return count;
}

