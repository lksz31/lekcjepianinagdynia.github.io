<script>
// ═══════════════════════════════════════════════════
// TEORIA — SYSTEM NUT
// Reprezentacja: diaPos = pozycja diatoniczna względem C4=0
// C4=0, D4=1, E4=2, F4=3, G4=4, A4=5, H4=6
// C5=7, D5=8, ...  C3=-7, D3=-6, ...
// chromPos = pozycja chromatyczna (półtony od C0)
// ═══════════════════════════════════════════════════

// Diatoniczne nazwy stopni (indeks = stopień w gamie durowej: 0=C,1=D,2=E,3=F,4=G,5=A,6=H)
const DIA_NAMES_PL = ['C','D','E','F','G','A','H'];
// Enharmoniczne nazwy z krzyżykiem/bemolm
const CHROMA_TO_NAME = {
  0:'C', 1:'Cis', 2:'D', 3:'Es', 4:'E', 5:'F',
  6:'Fis', 7:'G', 8:'Gis', 9:'A', 10:'Ais', 11:'H'
};
const CHROMA_TO_NAME_SHARP = {
  0:'C',1:'Cis',2:'D',3:'Dis',4:'E',5:'F',
  6:'Fis',7:'G',8:'Gis',9:'A',10:'Ais',11:'H'
};
// chroma → diaPos offset within octave (0-based) — KRZYŻYKOWA enharmonia
const CHROMA_TO_DIA_OFFSET = {
  0:0,1:0,2:1,3:1,4:2,5:3,6:3,7:4,8:4,9:5,10:5,11:6
};
// chroma → diaPos offset — BEMOLOWA enharmonia (Ges=4, Des=1, As=5, Es=2, B=6)
const CHROMA_TO_DIA_OFFSET_FLAT = {
  0:0,1:1,2:1,3:2,4:2,5:3,6:4,7:4,8:5,9:5,10:6,11:6
};

function getDiaOffsetMap(keyName) {
  const k = KEYS.find(k=>k.name===keyName);
  return (k && k.flats > 0) ? CHROMA_TO_DIA_OFFSET_FLAT : CHROMA_TO_DIA_OFFSET;
}

// Koło kwintowe — wszystkie tonacje
