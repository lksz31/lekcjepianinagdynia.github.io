<main class="main">
  <div style="text-align:center;">
    <div class="badge-prealpha" style="margin-bottom:10px;">Pre-Alpha</div>
    <h1 class="page-title">Pochody <em>funkcyjne</em></h1>
    <p class="page-sub">Prowadzenie głosów SATB w układzie czterogłosowym</p>
  </div>

  <!-- Panel ustawień -->
  <div class="ctrl-outer">
    <div class="ctrl-topbar">
      <span class="ctrl-topbar-title">🎵 Ustawienia</span>
    </div>
    <div class="ctrl-body">
      <!-- Układ głosów — PIERWSZA OPCJA -->
      <div class="ctrl-row">
        <span class="ctrl-lbl">Układ</span>
        <div class="ctrl-btns">
          <button class="cb active" id="cb-skupiony" onclick="setLayout('skupiony')">Skupiony</button>
          <button class="cb" id="cb-rozlegly" onclick="setLayout('rozlegly')">Rozległy</button>
