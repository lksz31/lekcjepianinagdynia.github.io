// ZNAKI CHROMATYCZNE PRZY NUTACH
// ═══════════════════════════════════════════════════

// Oblicz 7 dźwięków gamy durowej lub harmonicznej moll od korzenia
function getScaleChromas(keyName) {
  const k = KEYS.find(k=>k.name===keyName);
  const root = k && k.isMoll ? k.rootChroma : (KEY_CHROMA[keyName]??0);
  const isMoll = k && k.isMoll;
  // Dur: W W H W W W H = 0,2,4,5,7,9,11
  // Moll harmoniczny: W H W W H A H = 0,2,3,5,7,8,11
  const durIntervals  = [0,2,4,5,7,9,11];
  const mollIntervals = [0,2,3,5,7,8,11];
  const intervals = isMoll ? mollIntervals : durIntervals;
  return new Set(intervals.map(i => ((root+i)%12)));
}

// Stan alteracji w bieżącym takcie: dia → ostatnio użyte chroma
// Resetowane na początku każdego taktu
let _barAccState = {}; // key: diaPos, value: chroma użyte w tym takcie

function resetBarAccState() { _barAccState = {}; }

// Dla danej nuty i tonacji określ jaki znak chromatyczny narysować
// Zwraca: '#' | 'b' | 'n' (kasownik) | null (brak znaku)
function getNoteAccidental(note, keyName) {
  const scaleChromas = getScaleChromas(keyName);
  const keyData = KEYS.find(k=>k.name===keyName)||{sharps:0,flats:0};
  const chroma = note.chroma;
  const dia = note.dia;

  // Chroma "domyślne" dla tej pozycji diatonicznej wg armatura
  const nSharps = keyData.sharps||0;
  const nFlats  = keyData.flats||0;
  const sharpOrder = [6,1,8,3,10,5,0];  // F C G D A E H
  const flatOrder  = [10,3,8,1,6,11,4]; // B E A D G C F
  const alteredByKey = new Map(); // chroma → 'sharp'|'flat'
  for(let i=0;i<nSharps;i++) alteredByKey.set(sharpOrder[i],'sharp');
  for(let i=0;i<nFlats;i++)  alteredByKey.set(flatOrder[i],'flat');

  // "Litera" nuty — diaPos mod 7 daje stopień (0=C,1=D,...,6=H)
  const letterDia = ((dia % 7) + 7) % 7;
  // Naturalna chroma dla tej litery (C-dur, bez alteracji)
  const naturalChromaForLetter = [0,2,4,5,7,9,11][letterDia];
  // Chroma oczekiwane wg armaturę (z alteracją jeśli trzeba)
  // Chroma alterowane armatą dla tej litery
  const keyChromaForLetter = alteredByKey.has(chroma) ? chroma :
    (alteredByKey.has(naturalChromaForLetter) ? 
      naturalChromaForLetter + (alteredByKey.get(naturalChromaForLetter)==='sharp'?1:-1) :
      naturalChromaForLetter);

  // Chroma oczekiwane dla tej nuty wg armatura
  let expectedChroma = naturalChromaForLetter;
  if(alteredByKey.has((naturalChromaForLetter+1)%12)) expectedChroma = (naturalChromaForLetter+1)%12;
  else if(alteredByKey.has((naturalChromaForLetter-1+12)%12)) expectedChroma = (naturalChromaForLetter-1+12)%12;

  // Sprawdź stan z poprzednich nut w tym takcie
  const prevInBar = _barAccState[dia]; // chroma poprzedniej nuty na tej pozycji w takcie

  let result = null;

  if(chroma === expectedChroma) {
    // Nuta zgodna z armatą — czy poprzednia nuta w tym takcie była inna?
    if(prevInBar !== undefined && prevInBar !== chroma) {
      result = 'n'; // kasownik — poprzednia była alterowana
    }
    // else: brak znaku
  } else {
    // Nuta niezgodna z armatą
    if(prevInBar === chroma) {
      result = null; // ta sama alteracja już była w takcie — brak znaku
    } else {
      // Potrzebuje znaku
      if(chroma === naturalChromaForLetter) {
        result = 'n'; // naturalna, ale armatura alteruje → kasownik
      } else if(chroma === (naturalChromaForLetter+1)%12) {
        result = '#';
      } else if(chroma === (naturalChromaForLetter-1+12)%12) {
        result = 'b';
      } else {
        result = scaleChromas.has(chroma) ? null : '#';
      }
    }
  }

  // Zaktualizuj stan taktu
  _barAccState[dia] = chroma;
  return result;
}

// Narysuj znak chromatyczny przed nutą
function drawNoteAccidental(svg, nx, ny, accType, color) {
  const ACC_SYMBOLS = {'#':'♯', 'b':'♭', 'n':'♮'};
  const sym = ACC_SYMBOLS[accType];
  if(!sym) return;
  const t = addEl(svg,'text',{
    x: nx-20,
    y: ny+6,
    'font-size': accType==='n' ? '26' : '24',
    'font-family':'serif',
    fill: color||'#555',
    'text-anchor':'middle',
    'font-weight':'700'
  });
  t.textContent = sym;
}

function drawResult(voicings) {
  const n = voicings.length;
  const keyData = KEYS.find(k=>k.name===currentKey)||{sharps:0,flats:0};
  const nAccidentals = keyData.sharps||keyData.flats||0;
  const SL=20, CW=76+nAccidentals*20, BW=120, RMARGIN=20;

  // Oblicz ile akordów mieści się w jednym wierszu
  const container = document.querySelector('.svg-scroll');
  const availW = container ? container.clientWidth || 800 : 800;
  const maxPerRow = Math.max(1, Math.floor((availW - SL - CW - RMARGIN) / BW));

  // Metrum — określ rozmiar taktu
  const timeSig = getTimeSig(n);
  const barSize = timeSig ? timeSig.every : 0;

  // Podziel voicings na wiersze — CAŁE TAKTY nie mogą być rozbite
  const rows = [];
  let i = 0;
  while(i < n) {
    // Ile akordów zmieści się w tym wierszu?
    let count = Math.min(maxPerRow, n - i);
    if(barSize > 1) {
      // Przytnij do pełnych taktów
      const fullBars = Math.floor(count / barSize);
      if(fullBars > 0) count = fullBars * barSize;
      else count = barSize; // co najmniej jeden takt
      count = Math.min(count, n - i);
    }
    rows.push(voicings.slice(i, i + count));
    i += count;
  }
  const nRows = rows.length;

  const W = SL + CW + maxPerRow*BW + RMARGIN;
  const H = nRows * ROW_H + (nRows-1) * ROW_GAP + 24; // +24 na etykiety funkcji na górze

  const svg = document.getElementById('main-svg');
  svg.setAttribute('viewBox',`0 0 ${W} ${H}`);
  svg.setAttribute('preserveAspectRatio','xMinYMin meet');
  svg.style.width  = '100%';
  svg.style.height = 'auto';
  svg.innerHTML = '';

  // Rysuj każdy wiersz
  rows.forEach((rowVoicings, rowIdx) => {
    const rn = rowVoicings.length;
    const offsetY = rowIdx * (ROW_H + ROW_GAP);
    const SR = SL + CW + rn*BW;

    // Funkcja przesunięcia Y dla tego wiersza
    const tY = y => y + offsetY;
    const bY_row = y => y + offsetY;

    // Pięciolinie wiolinowe
    T_LINE_Y.forEach(y => drawLine(svg, SL, SR, tY(y), '#C8BEA8', '1.5'));
    // Pięciolinie basowe
    B_LINE_Y.forEach(y => drawLine(svg, SL, SR, bY_row(y), '#C8BEA8', '1.5'));

    // Łącznik pionowy (akolada) — od góry treble do dołu bass
    addEl(svg,'line',{x1:SL, y1:tY(T_LINE_Y[4]), x2:SL, y2:bY_row(B_LINE_Y[0]), stroke:'#C8BEA8', 'stroke-width':'2'});

    // Kreski taktowe — co 'every' akordów lub na końcu
    const timeSigLocal = getTimeSig(n);
    const barEvery = timeSigLocal ? timeSigLocal.every : 0;
    // Oblicz globalny indeks pierwszego akordu w tym wierszu
    const rowStart = rows.slice(0,rowIdx).reduce((s,r)=>s+r.length,0);
    // Zapamiętaj pozycje kresek taktowych (do resetu stanu)
    const barLinePositions = new Set();
    for(let i=1;i<=rn;i++){
      const globalIdx = rowStart + i;
      const isLast = i === rn;
      const isBarLine = isLast || (barEvery > 0 && globalIdx % barEvery === 0);
      if(!isBarLine) continue;
      barLinePositions.add(i);
      const bx = isLast ? SR : SL+CW+i*BW;
      addEl(svg,'line',{x1:bx,y1:tY(T_LINE_Y[4]),x2:bx,y2:tY(T_LINE_Y[0]),stroke:'#C8BEA8','stroke-width':'1.3'});
      addEl(svg,'line',{x1:bx,y1:bY_row(B_LINE_Y[0]),x2:bx,y2:bY_row(B_LINE_Y[4]),stroke:'#C8BEA8','stroke-width':'1.3'});
    }

    // Klucze
    addText(svg, SL+2, String(tY(T_LINE_Y[0]-8)), '88', 'serif', '#6B4F3A', '𝄞');
    addText(svg, SL+3, String(bY_row(B_LINE_Y[4]+58)), '88', 'serif', '#6B4F3A', '𝄢');

    // Znaki przykluczowe
    drawKeySignatureAt(svg, keyData, SL, offsetY);

    // Metrum — ustal na podstawie liczby wszystkich akordów
    const timeSig = getTimeSig(n);
    if(timeSig) drawTimeSig(svg, SL+CW-22, tY, bY_row, timeSig);

    // X pozycje nut w tym wierszu
    const noteXs = rowVoicings.map((_,i) => SL+CW+i*BW+BW/2);

    // Linie prowadzenia głosów
    for(let i=1;i<rn;i++){
      const a=rowVoicings[i-1], b=rowVoicings[i];
      const x1=noteXs[i-1], x2=noteXs[i];
      if(a.sopran&&b.sopran) drawTie(svg,x1,tY(diaToY_treble(a.sopran.dia)),x2,tY(diaToY_treble(b.sopran.dia)),VC.sopran,a.sopran.dia===b.sopran.dia);
      if(a.alt&&b.alt)       drawTie(svg,x1,tY(diaToY_treble(a.alt.dia)),   x2,tY(diaToY_treble(b.alt.dia)),   VC.alt,   a.alt.dia===b.alt.dia);
      if(a.tenor&&b.tenor)   drawTie(svg,x1,bY_row(diaToY_bass(a.tenor.dia)),x2,bY_row(diaToY_bass(b.tenor.dia)),VC.tenor,a.tenor.dia===b.tenor.dia);
      if(a.bass&&b.bass)     drawTie(svg,x1,bY_row(diaToY_bass(a.bass.dia)), x2,bY_row(diaToY_bass(b.bass.dia)), VC.bass, a.bass.dia===b.bass.dia);
    }

    // Nuty — reset stanu alteracji na początku wiersza
    resetBarAccState();
    const labelY = tY(T_LINE_Y[4]) - 8; // etykieta funkcji nad górną linią
    rowVoicings.forEach((v,i) => {
      const nx = noteXs[i];
      // Reset stanu alteracji przy kresce taktowej
      if(i > 0 && barLinePositions.has(i)) resetBarAccState();

      // Etykieta funkcji
      const fl = addEl(svg,'text',{x:nx,y:labelY,'font-size':'12','font-family':'Playfair Display,serif','font-weight':'700','text-anchor':'middle',fill:FC[v.chord.func]||'#888'});
      fl.textContent = v.chord.func;

      if(v.sopran){
        drawLedgersAt(svg,v.sopran.dia,nx,'treble',offsetY);
        const _acc_sopran = getNoteAccidental(v.sopran, currentKey);
        if(_acc_sopran) drawNoteAccidental(svg, nx, tY(diaToY_treble(v.sopran.dia)), _acc_sopran, VC.sopran);
        drawHead(svg,nx,tY(diaToY_treble(v.sopran.dia)),VC.sopran,noteNameFromDia(v.sopran));
        const sy=tY(diaToY_treble(v.sopran.dia));
        addEl(svg,'line',{x1:nx+11,y1:sy,x2:nx+11,y2:Math.min(sy-42,tY(T_LINE_Y[4])+4),stroke:'#555','stroke-width':'1.7'});
      }
      if(v.alt){
        drawLedgersAt(svg,v.alt.dia,nx,'treble',offsetY);
        const _acc_alt = getNoteAccidental(v.alt, currentKey);
        if(_acc_alt) drawNoteAccidental(svg, nx, tY(diaToY_treble(v.alt.dia)), _acc_alt, VC.alt);
        drawHead(svg,nx,tY(diaToY_treble(v.alt.dia)),VC.alt,noteNameFromDia(v.alt));
        const ay=tY(diaToY_treble(v.alt.dia));
        addEl(svg,'line',{x1:nx-11,y1:ay,x2:nx-11,y2:Math.max(ay+42,tY(T_LINE_Y[0])+4),stroke:'#555','stroke-width':'1.7'});
      }
      if(v.tenor){
        drawLedgersAt(svg,v.tenor.dia,nx,'bass',offsetY);
        const _acc_tenor = getNoteAccidental(v.tenor, currentKey);
        if(_acc_tenor) drawNoteAccidental(svg, nx, bY_row(diaToY_bass(v.tenor.dia)), _acc_tenor, VC.tenor);
        drawHead(svg,nx,bY_row(diaToY_bass(v.tenor.dia)),VC.tenor,noteNameFromDia(v.tenor));
        const ty=bY_row(diaToY_bass(v.tenor.dia));
        addEl(svg,'line',{x1:nx+11,y1:ty,x2:nx+11,y2:Math.min(ty-42,bY_row(B_LINE_Y[0])-4),stroke:'#555','stroke-width':'1.7'});
      }
      if(v.bass){
        drawLedgersAt(svg,v.bass.dia,nx,'bass',offsetY);
        const _acc_bass = getNoteAccidental(v.bass, currentKey);
        if(_acc_bass) drawNoteAccidental(svg, nx, bY_row(diaToY_bass(v.bass.dia)), _acc_bass, VC.bass);
        drawHead(svg,nx,bY_row(diaToY_bass(v.bass.dia)),VC.bass,noteNameFromDia(v.bass));
        const by=bY_row(diaToY_bass(v.bass.dia));
        addEl(svg,'line',{x1:nx-11,y1:by,x2:nx-11,y2:Math.max(by+42,bY_row(B_LINE_Y[4])+4),stroke:'#555','stroke-width':'1.7'});
      }

      // Etykieta akordu pod pięciolinią basową
      const al = addEl(svg,'text',{x:nx,y:bY_row(B_LINE_Y[4])+16,'font-size':'10','font-family':'Poppins,sans-serif','text-anchor':'middle',fill:'#9C8C7C'});
      al.textContent = v.chord.label||'';
    });
  });

  document.getElementById('staff-card').style.display='block';
}

function noteNameFromDia(n) {
  if(!n) return '?';
  return noteNameInKey(n.chroma, currentKey);
}

// Rysuje znaki przykluczowe po kluczu — z offsetY dla wielowierszowego systemu
function drawKeySignatureAt(svg, keyData, SL, offsetY) {
  const nSharps = keyData.sharps || 0;
  const nFlats  = keyData.flats  || 0;
  const ACC_W = 20;
  const KX = SL + 76;

  if(nSharps > 0) {
    for(let i=0; i<nSharps; i++) {
      addAcc(svg, KX+i*ACC_W, diaToY_treble(SHARPS_TREBLE_DIA[i]) - 1  + offsetY, '#', '#6B4F3A');
      addAcc(svg, KX+i*ACC_W, diaToY_bass(SHARPS_BASS_DIA[i]) - 1 + offsetY, '#', '#6B4F3A');
    }
  }
  if(nFlats > 0) {
    for(let i=0; i<nFlats; i++) {
      addAcc(svg, KX+i*ACC_W, diaToY_treble(FLATS_TREBLE_DIA[i]) - 10 + offsetY, 'b', '#6B4F3A');
      addAcc(svg, KX+i*ACC_W, diaToY_bass(FLATS_BASS_DIA[i]) - 9 + offsetY, 'b', '#6B4F3A');
    }
  }
}
// Stara wersja jako alias
function drawKeySignature(svg, keyData, SL) { drawKeySignatureAt(svg, keyData, SL, 0); }

// Rysuje pojedynczy znak chromatyczny (# lub b) w danym miejscu
function addAcc(svg, x, y, type, color) {
  const t = addEl(svg, 'text', {
    x, y: type==='#' ? y+10 : y+14,
    'font-size': type==='#' ? '29' : '32',
    'font-family': 'serif',
    fill: color,
    'text-anchor': 'middle',
    'font-weight': '400'
  });
  t.textContent = type === '#' ? '♯' : '♭';
}

function drawLedgersAt(svg, dia, nx, clef, offsetY) {
  if(clef === 'treble') {
    if(dia <= 0) {
      for(let d=0; d>=dia; d-=2) {
        const y = diaToY_treble(d)+offsetY;
        addEl(svg,'line',{x1:nx-17,y1:y,x2:nx+17,y2:y,stroke:'#AAA','stroke-width':'1.4'});
      }
    }
    if(dia >= 11) {
      for(let d=11; d<=dia; d+=2) {
        const y = diaToY_treble(d)+offsetY;
        addEl(svg,'line',{x1:nx-17,y1:y,x2:nx+17,y2:y,stroke:'#AAA','stroke-width':'1.4'});
      }
    }
  } else {
    // Linie dodane górne: c1(d=0), e1(d=2), g1(d=4)...
    if(dia >= 0) {
      for(let d=0; d<=dia; d+=2) {
        const y = diaToY_bass(d)+offsetY;
        addEl(svg,'line',{x1:nx-17,y1:y,x2:nx+17,y2:y,stroke:'#AAA','stroke-width':'1.4'});
      }
    }
    // Linie dodane dolne: E2(d=-12), C2(d=-14)...
    if(dia <= -12) {
      for(let d=-12; d>=dia; d-=2) {
        const y = diaToY_bass(d)+offsetY;
        addEl(svg,'line',{x1:nx-17,y1:y,x2:nx+17,y2:y,stroke:'#AAA','stroke-width':'1.4'});
      }
    }
  }
}
function drawLedgers(svg, dia, nx, clef) { drawLedgersAt(svg, dia, nx, clef, 0); }

function drawHead(svg, cx, cy, color, label) {
  addEl(svg,'ellipse',{cx,cy,rx:'11',ry:'8',fill:color});
  const t = addEl(svg,'text',{x:cx,y:cy+4,'font-size':'8','font-family':'Poppins,sans-serif',fill:'white','text-anchor':'middle','font-weight':'600'});
  t.textContent = (label||'').replace(/[0-9]/g,'');
}
function drawLine(svg,x1,x2,y,col,sw) {
  addEl(svg,'line',{x1,y1:y,x2,y2:y,stroke:col,'stroke-width':sw});
}
function drawTie(svg,x1,y1,x2,y2,col,same) {
  addEl(svg,'line',{x1:x1+12,y1,x2:x2-12,y2,stroke:col,'stroke-width':same?'1':'1.5','stroke-dasharray':same?'4,3':'none','opacity':same?'0.4':'0.85'});
}
function addEl(svg,tag,attrs) {
  const e=document.createElementNS('http://www.w3.org/2000/svg',tag);
  Object.entries(attrs).forEach(([k,v])=>e.setAttribute(k,String(v)));
  svg.appendChild(e); return e;
}
function addText(svg,x,y,fs,ff,fill,txt) {
  const e=addEl(svg,'text',{x,y,'font-size':fs,'font-family':ff,fill});
  e.textContent=txt; return e;
}

// ═══════════════════════════════════════════════════
// UI STATE
// ═══════════════════════════════════════════════════
let currentKey = 'C';
let currentMode2 = 'dur';  // dur / moll
let currentLayout = 'skupiony';
let noteNameLang = 'pl';  // 'pl' | 'en'
let seq = [];          // ciąg funkcyjny (T,S,D,t,s,d)
let chordSeq = [];     // ciąg akordowy (nazwy tonacji)
const MAX_SEQ = 10;

// Blokada wzajemna
function canAddFunc()  { return chordSeq.length === 0; }
function canAddChord() { return seq.length === 0; }

function dropChord(event) {
  event.preventDefault();
  if(!canAddChord()) return;
  const keyName = event.dataTransfer.getData('keyName');
  if(!keyName || chordSeq.length >= MAX_SEQ) return;
  chordSeq.push(keyName);
  renderChordSeq();
}

// Drop na ciąg funkcyjny — tylko funkcje (T S D itd.)
function dropToFuncSeq(event) {
  event.preventDefault();
  const ft = event.dataTransfer.getData('funcType');
  if(ft && canAddFunc() && seq.length < MAX_SEQ) {
    seq.push(ft);
    renderSeq();
    renderChordSeq();
  }
}

// Drop tonacji na kwadracik zmiany tonacji
function dropKeyToChangeKey(event) {
  event.preventDefault();
  document.getElementById('key-drop-zone').classList.remove('key-drop-over');
  const kn = event.dataTransfer.getData('keyName');
  if(kn) {
    currentKey = kn;
    buildKeyGrid();
  }
}

// Śmietniczek funkcyjny
function dropToFuncTrash(event) {
  event.preventDefault();
  document.getElementById('func-trash').classList.remove('over');
  const idxStr = event.dataTransfer.getData('funcIdx');
  if(idxStr !== '') {
    const idx = parseInt(idxStr);
    if(!isNaN(idx) && idx >= 0 && idx < seq.length) { seq.splice(idx,1); renderSeq(); }
  } else {
    // Wyczyść cały ciąg
    seq = []; renderSeq();
  }
}

// Śmietniczek akordowy
function dropToChordTrash(event) {
  event.preventDefault();
  document.getElementById('chord-trash').classList.remove('over');
  const idxStr = event.dataTransfer.getData('chordIdx');
  if(idxStr !== '') {
    const idx = parseInt(idxStr);
    if(!isNaN(idx) && idx >= 0 && idx < chordSeq.length) { chordSeq.splice(idx,1); renderChordSeq(); }
  } else {
    chordSeq = []; renderChordSeq();
  }
}

function removeChordAt(i) { chordSeq.splice(i,1); renderChordSeq(); }

function renderChordSeq() {
  const zone = document.getElementById('chord-drop-zone');
  const emptyMsg = document.getElementById('chord-empty-msg');
  const funcSection = document.getElementById('func-seq-section');
  const chordSection = document.getElementById('chord-seq-section');

  // Blokada wizualna
  if(funcSection)  funcSection.style.opacity = canAddFunc()  ? '1' : '0.4';
  if(chordSection) chordSection.style.opacity = canAddChord() ? '1' : '0.4';
  if(emptyMsg) emptyMsg.style.display = chordSeq.length ? 'none' : '';

  // Renderuj chipy akordowe (bez funkcji — to są nazwy tonacji)
  const chips = chordSeq.map((kn,i) => {
    const k = KEYS.find(k=>k.name===kn);
    const lbl = k ? keyLabel(k) : kn;
    const isMoll = k && k.isMoll;
    return `${i?'<span class="seq-arrow">→</span>':''}<span class="seq-chip" draggable="true"
      style="background:${isMoll?'#FCE4EC':'#FFF3E0'};color:${isMoll?'#880E4F':'#C8882A'};border:1.5px solid ${isMoll?'#880E4F':'#C8882A'};cursor:grab;"
      ondragstart="event.dataTransfer.setData('chordIdx','${i}')"
      onclick="removeChordAt(${i})" title="Kliknij by usunąć lub przeciągnij do kosza">${lbl}</span>`;
  }).join('');

  // Zachowaj empty placeholder jako element, nie innerHTML
  const existing = zone.querySelectorAll('.seq-chip,.seq-arrow');
  existing.forEach(e=>e.remove());
  if(chordSeq.length) {
    const tmp = document.createElement('div');
    tmp.style.display='contents';
    tmp.innerHTML = chips;
    zone.appendChild(tmp);
  }
}

// Zbuduj siatki tonacji: dur i moll, C centrum, krzyżyki prawo, bemole lewo
function buildKeyGrid() {
  buildOneKeyGrid('key-grid-dur',  false);
  buildOneKeyGrid('key-grid-moll', true);
  // Zaktualizuj etykietę w topbarze
  const k = KEYS.find(k=>k.name===currentKey);
  if(k) {
    const isMoll = !!k.isMoll;
    const lbl = keyLabel(k) + (isMoll?' moll':' dur');
    const el = document.getElementById('topbar-key');
    if(el) el.textContent = lbl;
  }
}

function buildOneKeyGrid(containerId, isMollGrid) {
  const grid = document.getElementById(containerId);
  if(!grid) return;
  grid.innerHTML = '';

  // Filtruj klucze: dur lub moll
  const subset = KEYS.filter(k => isMollGrid ? !!k.isMoll : !k.isMoll);
  // Posortuj: bemole od największej liczby do 0, C w środku, krzyżyki od 1 do 7
  const flats  = subset.filter(k=>k.flats>0).sort((a,b)=>b.flats-a.flats);
  const center = subset.filter(k=>k.flats===0&&k.sharps===0);
  const sharps = subset.filter(k=>k.sharps>0).sort((a,b)=>a.sharps-b.sharps);
  const ordered = [...flats, ...center, ...sharps];

  ordered.forEach(k => {
    const btn = document.createElement('button');
    const typeClass = k.type.includes('sharp')?' sharps':k.type.includes('flat')?' flats':'';
    btn.className = 'key-btn'+typeClass + (k.name===currentKey?' active':'');
    btn.style.flexShrink = '0';
    const lbl = keyLabel(k);
    btn.textContent = lbl;
    if(k.sharps>0) {
      btn.setAttribute('data-count', String(k.sharps));
      btn.setAttribute('data-sign', '♯');
    } else if(k.flats>0) {
      btn.setAttribute('data-count', String(k.flats));
      btn.setAttribute('data-sign', '♭');
    }
    // Drag — pozwala przeciągać tonację do ciągu akordowego
    btn.draggable = true;
    btn.addEventListener('dragstart', e => {
      e.dataTransfer.setData('keyName', k.name);
    });
    btn.onclick = () => {
      // Kliknięcie tonacji:
      // - jeśli ciąg akordowy aktywny (seq pusty) → dodaj do ciągu akordowego
      // - jeśli ciąg funkcyjny aktywny (chordSeq pusty) → zmień tonację główną
      // - jeśli oba puste → dodaj do ciągu akordowego
      if(seq.length > 0) {
        // Ciąg funkcyjny aktywny — kliknięcie zmienia tonację
        currentKey = k.name;
        buildKeyGrid();
      } else if(chordSeq.length < MAX_SEQ) {
        chordSeq.push(k.name);
        renderChordSeq();
      }
    };
    grid.appendChild(btn);
  });
  // Przeciąganie siatki myszką/palcem (scroll horizontal)
  let isDown=false, startX, scrollLeft;
  grid.addEventListener('mousedown', e=>{isDown=true;startX=e.pageX-grid.offsetLeft;scrollLeft=grid.scrollLeft;});
  grid.addEventListener('mouseleave', ()=>isDown=false);
  grid.addEventListener('mouseup', ()=>isDown=false);
  grid.addEventListener('mousemove', e=>{if(!isDown)return;e.preventDefault();const x=e.pageX-grid.offsetLeft;const walk=(x-startX)*1.5;grid.scrollLeft=scrollLeft-walk;});
}

// Etykiety funkcji — mollowe jako duże litery ze stopniem
// Funkcja zwraca HTML etykiety zależnie od języka
function getFuncHTML(f) {
  if(noteNameLang === 'en') {
    // Angielski: i (tonic minor), iv (subdominant minor), v (dominant minor)
    const enMap = {
      T:'T', S:'S', D:'D',
      t:'<small style="font-size:0.62em;font-style:italic;">i</small>T',
      s:'<small style="font-size:0.62em;font-style:italic;">iv</small>S',
      d:'<small style="font-size:0.62em;font-style:italic;">v</small>D'
    };
    return enMap[f]||f;
  }
  // Polski: T S D (dur), °T °S °D (moll)
  const plMap = {
    T:'T', S:'S', D:'D',
    t:'<span style="font-size:1.25em;vertical-align:middle;line-height:1;">°</span>T',
    s:'<span style="font-size:1.25em;vertical-align:middle;line-height:1;">°</span>S',
    d:'<span style="font-size:1.25em;vertical-align:middle;line-height:1;">°</span>D'
  };
  return plMap[f]||f;
}
const FUNC_HTML = {
  T:'T', S:'S', D:'D',
  get t(){ return getFuncHTML('t'); },
  get s(){ return getFuncHTML('s'); },
  get d(){ return getFuncHTML('d'); }
};
const FUNC_TITLES = {
  T:'Tonika (I dur)', S:'Subdominanta (IV dur)', D:'Dominanta (V dur)',
  t:'Tonika moll (I moll)', s:'Subdominanta moll (IV moll)', d:'Dominanta moll (V)'
};

function funcChipHTML(f, idx) {
  const arrow = idx > 0 ? '<span class="seq-arrow">→</span>' : '';
  return `${arrow}<span class="seq-chip ${f}" draggable="true"
    ondragstart="event.dataTransfer.setData('funcIdx','${idx}')"
    ondragend="this.style.opacity='1'"
    onclick="removeAt(${idx})" title="Kliknij by usunąć lub przeciągnij do kosza">${getFuncHTML(f)}</span>`;
