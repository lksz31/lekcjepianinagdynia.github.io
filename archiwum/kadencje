// Zbuduj przyciski funkcji
function buildFuncBtns() {
  const row = document.getElementById('func-btns');
  row.innerHTML = '';
  const allFuncs = ['T','S','D','sep','t','s','d'];
  allFuncs.forEach(f => {
    if(f==='sep') { const s=document.createElement('div'); s.className='fb-sep'; row.appendChild(s); return; }
    const btn = document.createElement('button');
    btn.className='fb '+f;
    btn.draggable = true;
    btn.innerHTML = getFuncHTML(f);
    btn.title = FUNC_TITLES[f]||f;
    btn.addEventListener('dragstart', e => {
      e.dataTransfer.setData('funcType', f);
    });
    btn.onclick = () => addFunc(f);
    row.appendChild(btn);
  });
  // Usuń ostatnią
  const rm = document.createElement('button');
  rm.className='fb rm'; rm.textContent='← Usuń';
  rm.onclick = removeFunc;
  row.appendChild(rm);
}

function addFunc(f) {
  if(!canAddFunc()) { alert('Wyczyść ciąg akordowy najpierw.'); return; }
  if(seq.length >= MAX_SEQ) return;
  seq.push(f);
  renderSeq();
  renderChordSeq(); // odśwież blokadę
}
function removeFunc() { seq.pop(); renderSeq(); }
function clearAll() {
  seq=[]; chordSeq=[];
  renderSeq(); renderChordSeq();
  document.getElementById('staff-card').style.display='none';
  document.getElementById('info-row').textContent='';
  document.getElementById('err-row').textContent='';
}

function renderSeq() {
  const el = document.getElementById('seq-disp');
  document.getElementById('seq-count').textContent = (seq.length||chordSeq.length)+' / '+MAX_SEQ;
  if(!seq.length){ el.innerHTML='<span class="seq-empty">Przeciągnij lub kliknij funkcje…</span>'; renderChordSeq(); return; }
  el.innerHTML = seq.map((f,i) => funcChipHTML(f,i)).join('');
  renderChordSeq();
}
function removeAt(i) { seq.splice(i,1); renderSeq(); renderChordSeq(); }

function setMode2(m) {
  currentMode2=m;
  document.getElementById('cb-dur').classList.toggle('active',m==='dur');
  document.getElementById('cb-moll').classList.toggle('active',m==='moll');
}
function setLayout(l) {
  currentLayout=l;
  document.getElementById('cb-skupiony').classList.toggle('active',l==='skupiony');
  document.getElementById('cb-rozlegly').classList.toggle('active',l==='rozlegly');
}

function randomizeChordSeq() {
  if(!canAddChord()) { alert('Wyczyść ciąg funkcyjny najpierw.'); return; }
  // Wybierz losowe tonacje z aktualnego zestawu (dur lub moll)
  const allKeys = KEYS.filter(k => !k.isMoll); // domyślnie dur
  const n = 3 + Math.floor(Math.random()*4);
  chordSeq = [];
  // Zawsze zacznij od aktualnej tonacji
  chordSeq.push(currentKey);
  for(let i=1;i<n;i++){
    const prev = chordSeq[chordSeq.length-1];
    const candidates = allKeys.filter(k=>k.name!==prev);
    chordSeq.push(candidates[Math.floor(Math.random()*candidates.length)].name);
  }
  renderChordSeq();
}

function randomizeSeq() {
  if(!canAddFunc()) { alert('Wyczyść ciąg akordowy najpierw.'); return; }
  const funcs = ['T','S','D','t','s','d'];
  // Logiczne sekwencje startujące od T lub t
  const starts = ['T','t'];
  const n = 3 + Math.floor(Math.random()*4); // 3-6 funkcji
  seq = [];
  // Zawsze zacznij od T lub t
  seq.push(starts[Math.floor(Math.random()*starts.length)]);
  const isMollStart = seq[0]==='t';
  // Dobieraj kolejne — preferuj sensowne następstwa
  const durSeq  = ['T','S','D','T','D','S','T','D','T'];
  const mollSeq = ['t','s','d','t','d','s','t','d','t'];
  const pool = isMollStart ? mollSeq : durSeq;
  for(let i=1;i<n;i++) {
    const candidates = pool.filter(f=>f!==seq[seq.length-1]);
    seq.push(candidates[Math.floor(Math.random()*candidates.length)]);
  }
  // Zakończ T lub t
  if(seq[seq.length-1]!=='T' && seq[seq.length-1]!=='t') {
    seq.push(isMollStart?'t':'T');
  }
  renderSeq();
}
function setNoteLang(l) {
  noteNameLang=l;
  document.getElementById('cb-lang-pl').classList.toggle('active',l==='pl');
  document.getElementById('cb-lang-en').classList.toggle('active',l==='en');
  buildKeyGrid();
  buildFuncBtns();  // odśwież etykiety T°/t
  renderSeq();      // odśwież chipy
  if(_lastVoicings && _lastVoicings.length) drawResult(_lastVoicings);
}

function generate() {
  const useChord = chordSeq.length > 0;
  const useFunc  = seq.length > 0;
  if(!useChord && !useFunc) { document.getElementById('info-row').textContent='Dodaj funkcje lub przeciągnij tonacje.'; return; }
  
  const voicings = useChord ? generateChordSeqVoicings() : generateVoicings();
  if(!voicings.length) { document.getElementById('info-row').textContent='Nie udało się wygenerować.'; return; }
  
  drawResult(voicings);
  
  const infos = [];
  for(let i=1;i<voicings.length;i++){
    const a=voicings[i-1], b=voicings[i];
    infos.push(useChord ?
      (()=>{ const ka=KEYS.find(k=>k.name===a.chord._keyName); const kb=KEYS.find(k=>k.name===b.chord._keyName); return (ka?keyLabel(ka):'?')+'→'+(kb?keyLabel(kb):'?'); })() :
      `${a.chord.func}→${b.chord.func}`);
  }
  _lastVoicings = voicings;
  document.getElementById('info-row').textContent = 'Pochód: ' + infos.join(' ');
  
  const errs = checkErrors(voicings);
  document.getElementById('err-row').textContent = errs.length ? '⚠ ' + errs.join(' | ') : '';
}

// Generuj voicings dla ciągu akordowego — z retry
function generateChordSeqVoicings() {
  if(!chordSeq.length) return [];
  const lay = currentLayout;
  const startPositions = ['kwinta','tercja','pryma','kwinta','tercja'];
  let best = null, bestErrors = 9999;
  for(const sp of startPositions) {
    const chord0 = buildChordFromKey(chordSeq[0]);
    const voicings = [buildVoicing(chord0, lay, sp)];
    for(let i=1;i<chordSeq.length;i++){
      const chord = buildChordFromKey(chordSeq[i]);
      voicings.push(leadVoices(voicings[i-1], chord, lay));
    }
    const errs = checkErrors(voicings).length + countParallelErrors(voicings);
    if(errs < bestErrors) { bestErrors = errs; best = voicings; }
    if(bestErrors === 0) break;
  }
  return best || [];
}

// Buduj akord toniki z nazwy klucza (dur lub moll)
function buildChordFromKey(keyName) {
  const k = KEYS.find(k=>k.name===keyName);
  const isMoll = k && k.isMoll;
  const func = isMoll ? 't' : 'T';
  const chord = buildChord(keyName, func);
  chord._keyName = keyName;
  return chord;
}

// ═══════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════
buildKeyGrid();
buildFuncBtns();
renderSeq();

// Przerysuj przy zmianie rozmiaru okna
let _lastVoicings = null;
const _resizeObs = new ResizeObserver(() => {
  if(_lastVoicings && _lastVoicings.length) drawResult(_lastVoicings);
});
_resizeObs.observe(document.querySelector('.svg-scroll') || document.body);
