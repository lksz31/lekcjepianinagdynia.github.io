function keyLabel(k){ return noteNameLang==='en' ? k.labelEn : k.labelPl; }

const CHROMA_TO_NAME_EN = {
  0:'C', 1:'C#', 2:'D', 3:'Eb', 4:'E', 5:'F',
  6:'F#', 7:'G', 8:'G#', 9:'A', 10:'Bb', 11:'B'
};
// Chroma prymy dla każdej tonacji
const KEY_CHROMA = {
  C:0,G:7,D:2,A:9,E:4,H:11,Fis:6,Cis:1,
  F:5,B:10,Es:3,As:8,Des:1,Ges:6,Ces:11
};
function getKeyChroma(keyName) {
  const k = KEYS.find(k=>k.name===keyName);
  if(k && k.isMoll && k.rootChroma!==undefined) return k.rootChroma;
  return KEY_CHROMA[keyName] ?? 0;
}

// Interwały durowe (chroma od prymy): pryma=0, w2=2, w3=4, c4=5, c5=7, w6=9, w7=11
// Tryb durowy: I=dur, II=moll, III=moll, IV=dur, V=dur, VI=moll, VII=zm
// T = I stopień durowy, S = IV stopień durowy, D = V stopień durowy
// t = I stopień mollowy, s = IV stopień mollowy, d = V stopień (dur w harmonicznym)

// Buduj akord: {root_chroma, third_chroma, fifth_chroma, root_dia_name, label}
function buildChord(keyName, func) {
  const kr = getKeyChroma(keyName);
  let rootC, thirdC, fifthC, isMaj, label;

  if(func === 'T') {
    rootC = kr; thirdC = (kr+4)%12; fifthC = (kr+7)%12; isMaj=true;
    label = noteName(kr)+'';
  } else if(func === 'S') {
    rootC = (kr+5)%12; thirdC = (kr+9)%12; fifthC = (kr+0)%12; isMaj=true;
    label = noteName((kr+5)%12)+'';
  } else if(func === 'D') {
    rootC = (kr+7)%12; thirdC = (kr+11)%12; fifthC = (kr+2)%12; isMaj=true;
    label = noteName((kr+7)%12)+'';
  } else if(func === 't') {
    // moll tonika: m3 + w3
    rootC = kr; thirdC = (kr+3)%12; fifthC = (kr+7)%12; isMaj=false;
    label = noteName(kr)+'m';
  } else if(func === 's') {
    // moll subdominanta
    rootC = (kr+5)%12; thirdC = (kr+8)%12; fifthC = (kr+0)%12; isMaj=false;
    label = noteName((kr+5)%12)+'m';
  } else if(func === 'd') {
    // dominanta w moll — harmoniczna: dur (V stopień harmonicznego moll = dur)
    rootC = (kr+7)%12; thirdC = (kr+11)%12; fifthC = (kr+2)%12; isMaj=true;
    label = noteName((kr+7)%12)+'';
  }
  return {func, rootC, thirdC, fifthC, isMaj, label, chromas:[rootC, thirdC, fifthC]};
}

function noteName(c) {
  return noteNameInKey(c, currentKey);
}
function noteNameInKey(c, keyName) {
  const chroma = ((c%12)+12)%12;
  const k = KEYS.find(k=>k.name===keyName);
  if(noteNameLang==='en') {
    // EN: krzyżykowe tonacje → sharp names, bemolowe → flat names
    const useFlat = k && k.flats > 0;
    const enSharp = {0:'C',1:'C#',2:'D',3:'D#',4:'E',5:'F',6:'F#',7:'G',8:'G#',9:'A',10:'A#',11:'B'};
    const enFlat  = {0:'C',1:'Db',2:'D',3:'Eb',4:'E',5:'F',6:'Gb',7:'G',8:'Ab',9:'A',10:'Bb',11:'B'};
    return (useFlat ? enFlat : enSharp)[chroma] || '?';
  }
  // PL: wybierz mapę zależnie od tonacji
  const isSharpKey = k && k.sharps > 0;
  const isFlatKey  = k && k.flats  > 0;
  const sharpMap = {0:'C',1:'Cis',2:'D',3:'Dis',4:'E',5:'F',6:'Fis',7:'G',8:'Gis',9:'A',10:'Ais',11:'H'};
  const flatMap  = {0:'C',1:'Des',2:'D',3:'Es', 4:'E',5:'F',6:'Ges',7:'G',8:'As', 9:'A',10:'B',  11:'H'};
  const neutral  = {0:'C',1:'Cis',2:'D',3:'Es', 4:'E',5:'F',6:'Fis',7:'G',8:'Gis',9:'A',10:'Ais',11:'H'};
  if(isFlatKey)  return flatMap[chroma]  || '?';
  if(isSharpKey) return sharpMap[chroma] || '?';
  return neutral[chroma] || '?';
}

// ═══════════════════════════════════════════════════
// ZAKRESY GŁOSÓW (diaPos względem C4=0)
// Sopran: h małe (H3) do a dwukreślne (A5)
//   H3: diaPos = H=6, oktawa3 → 6-7=-1... 
//   Przelicz: diaPos(H,oct) = 6 + (oct-4)*7
//   H3 = 6 + (3-4)*7 = 6-7 = -1
//   A5 = 5 + (5-4)*7 = 5+7 = 12
// Alt: e małe (E3) do d dwukreślne (D6)
//   E3 = 2 + (3-4)*7 = 2-7 = -5
//   D6 = 1 + (6-4)*7 = 1+14 = 15
// Tenor: c małe (C3) do a razkreślne (A4)
//   C3 = 0 + (3-4)*7 = -7
//   A4 = 5
// Bas: E wielkie (E2) do d razkreślne (D5)
//   E2 = 2 + (2-4)*7 = 2-14 = -12
//   D5 = 1 + (5-4)*7 = 1+7 = 8
// ═══════════════════════════════════════════════════
const RANGES = {
  sopran: {min:-1, max:12},   // H3..A5
  alt:    {min:-5, max:15},   // E3..D6 (szeroki zakres)
  tenor:  {min:-7, max:5},    // C3..A4
  bass:   {min:-12, max:8},   // E2..D5
};

// Reguła: głosy nie mogą się krzyżować
// sopran > alt > tenor > bass (diaPos)

// ═══════════════════════════════════════════════════
// PRZELICZANIE: chroma → diaPos w danej oktawie
// ═══════════════════════════════════════════════════
function chromaToDia(chroma, octave, keyName) {
  const c = ((chroma%12)+12)%12;
  const map = keyName ? getDiaOffsetMap(keyName) : CHROMA_TO_DIA_OFFSET;
  return map[c] + (octave-4)*7;
}

function diaToY_treble(d) { return 150 - d*10; }  // +20: nuty były 2 pozycje za wysoko
function diaToY_bass(d)   {
  // Linie basowe: G2(d=-10)=300, H2(d=-8)=280, d(d=-6)=260, f(d=-4)=240, a(d=-2)=220
  // c1(d=0)=200 (L1 dod.górna), C2(d=-14)=340 (L2 dod.dolna)
  return 306 - (d + 10) * 10;  // +30 odstęp od treble
}

// ═══════════════════════════════════════════════════
// ZNAJDŹ NAJBLIŻSZY DŹWIĘK akordowy do targetDia
// w danym zakresie
// ═══════════════════════════════════════════════════
function findClosest(chroma, targetDia, minD, maxD) {
  const c = ((chroma%12)+12)%12;
  let best = null, bd = 9999;
  for(let oct = 0; oct <= 8; oct++) {
    const d = chromaToDia(c, oct, currentKey);
    if(d < minD || d > maxD) continue;
    const dist = Math.abs(d - targetDia);
    if(dist < bd) { bd = dist; best = {chroma:c, dia:d, oct}; }
  }
  return best;
}

// ═══════════════════════════════════════════════════
// UKŁAD: skupiony / rozległy
// W układzie skupiony: sopran, alt, tenor mieszczą się w oktawie
// W układzie rozległy: sopran i tenor są oddalone o oktawę+
// ═══════════════════════════════════════════════════

// Dla danego akordu i pozycji sopranu (która nuta: pryma/tercja/kwinta)
// zbuduj voicing w danym układzie
function buildVoicing(chord, layout, startPos) {
  // startPos: 'pryma'|'tercja'|'kwinta' — co jest w soprani
  const chromas = chord.chromas;
  let sopChroma, altChroma, tenorChroma, bassChroma;
  
  // Bas zawsze pryma
  bassChroma = chord.rootC;

  // Subdominanta (S/s): zdwojona PRYMA — bas + tenor = pryma, alt = tercja
  const isSubdom = chord.func === 'S' || chord.func === 's';
  if(isSubdom) {
    // Tenor: pryma (zdwojenie z basem)
    tenorChroma = chord.rootC;
    // Alt: tercja
    altChroma = chord.thirdC;
    // Sopran: zależnie od startPos
    if(startPos === 'pryma')        sopChroma = chord.rootC;
    else if(startPos === 'tercja')  sopChroma = chord.thirdC;
    else                            sopChroma = chord.fifthC; // kwinta
  } else {
    if(startPos === 'pryma') {
      sopChroma = chord.rootC; altChroma = chord.fifthC; tenorChroma = chord.thirdC;
    } else if(startPos === 'tercja') {
      sopChroma = chord.thirdC; altChroma = chord.rootC; tenorChroma = chord.fifthC;
    } else { // kwinta
      sopChroma = chord.fifthC; altChroma = chord.thirdC; tenorChroma = chord.rootC;
    }
  }
  
  // Znajdź optymalne pozycje oktawowe
  // Bas: zakres -12..8, preferujemy dolny rejestr
  let bassNote = findInRange(bassChroma, RANGES.bass.min, RANGES.bass.max, -9); // C2 obszar
  
  // Tenor: powyżej basu, zakres -7..5
  let tenorNote = findInRange(tenorChroma, Math.max(RANGES.tenor.min, bassNote.dia+1), RANGES.tenor.max, bassNote.dia+2);
  
  if(layout === 'skupiony') {
    // Alt w oktawie tenoraZ
    let altNote = findInRange(altChroma, tenorNote.dia+1, Math.min(tenorNote.dia+7, RANGES.alt.max), tenorNote.dia+2);
    // Sopran powyżej alta, blisko
    let sopNote = findInRange(sopChroma, altNote.dia+1, Math.min(altNote.dia+8, RANGES.sopran.max), altNote.dia+2);
    return {sopran:sopNote, alt:altNote, tenor:tenorNote, bass:bassNote, chord};
  } else {
    // Rozległy: alt i sopran wyżej o oktawę
    let altNote = findInRange(altChroma, tenorNote.dia+4, Math.min(tenorNote.dia+11, RANGES.alt.max), tenorNote.dia+6);
    let sopNote = findInRange(sopChroma, altNote.dia+1, Math.min(altNote.dia+8, RANGES.sopran.max), altNote.dia+3);
    return {sopran:sopNote, alt:altNote, tenor:tenorNote, bass:bassNote, chord};
  }
}

function findInRange(chroma, minD, maxD, prefD) {
  const c = ((chroma%12)+12)%12;
  // Znajdź wszystkie pozycje w zakresie
  const candidates = [];
  for(let oct=0; oct<=8; oct++) {
    const d = chromaToDia(c, oct, currentKey);
    if(d >= minD && d <= maxD) candidates.push({chroma:c, dia:d, oct});
  }
  if(!candidates.length) {
    // Relaks zakresu
    for(let oct=0; oct<=8; oct++) {
      const d = chromaToDia(c, oct);
      if(d >= minD-3 && d <= maxD+3) candidates.push({chroma:c, dia:d, oct});
    }
  }
  if(!candidates.length) return {chroma:c, dia:prefD, oct:4};
  // Wybierz najbliższy do preferencji
  return candidates.reduce((best,n) => Math.abs(n.dia-prefD) < Math.abs(best.dia-prefD) ? n : best);
}

// ═══════════════════════════════════════════════════
// PROWADZENIE GŁOSÓW
// ═══════════════════════════════════════════════════

function leadVoices(prev, nextChord, layout) {
  const pf = prev.chord.func;
  const nf = nextChord.func;
  
  // Czy to samo połączenie akordów?
  if(prev.chord.rootC === nextChord.rootC &&
     prev.chord.thirdC === nextChord.thirdC &&
     prev.chord.fifthC === nextChord.fifthC) {
    return repeatChord(prev, nextChord, layout);
  }
  
  // Sprawdź typ połączenia
  // Połączenie kwintowe: T↔S, T↔D, D↔T, S↔T (i mollowe odpowiedniki)
  const quintalPairs = [
    ['T','S'],['T','D'],['D','T'],['S','T'],
    ['t','s'],['t','d'],['d','t'],['s','t'],
    ['T','s'],['t','S'],['T','d'],['t','D'],
  ];
  const secondalPairs = [
    ['S','D'],['D','S'],['s','d'],['d','s'],
    ['S','d'],['s','D'],['D','s'],['d','S'],
  ];
  
  const isQuintal = quintalPairs.some(([a,b]) => a===pf && b===nf);
  const isSecondal = secondalPairs.some(([a,b]) => a===pf && b===nf);
  
  if(isQuintal) return leadQuintal(prev, nextChord, layout);
  if(isSecondal) return leadSecondal(prev, nextChord, layout);
  
  // Domyślnie: ruch krokami
  return leadGeneral(prev, nextChord, layout);
}

// ŁĄCZENIE KWINTOWE
function leadQuintal(prev, nextChord, layout) {
  const nc = nextChord;
  
  // 1. Znajdź wspólny dźwięk (chroma)
  const prevChromas = [prev.chord.rootC, prev.chord.thirdC, prev.chord.fifthC];
  const nextChromas = [nc.rootC, nc.thirdC, nc.fifthC];
  const commonChroma = prevChromas.find(c => nextChromas.includes(c));
  
  // 2. Bas skacze kwartem/kwintą na prymę następnego
  const newBass = findInRange(nc.rootC, RANGES.bass.min, RANGES.bass.max, prev.bass.dia);
  
  // 3. Tenor
  let newTenor;
  if(commonChroma !== undefined) {
    // Wspólny dźwięk w tenorze jeśli tam był
    if(prev.tenor.chroma === commonChroma) {
      newTenor = {...prev.tenor}; // zostaje
    } else {
      newTenor = findClosest(nc.rootC === commonChroma ? nc.thirdC : 
                 nc.thirdC === commonChroma ? nc.rootC : nc.thirdC,
                 prev.tenor.dia, 
                 Math.max(RANGES.tenor.min, newBass.dia+1), RANGES.tenor.max);
    }
  } else {
    newTenor = findClosest(nc.thirdC, prev.tenor.dia, Math.max(RANGES.tenor.min, newBass.dia+1), RANGES.tenor.max);
  }
  if(!newTenor) newTenor = findInRange(nc.thirdC, Math.max(RANGES.tenor.min,newBass.dia+1), RANGES.tenor.max, prev.tenor.dia);
  
  // 4. Alt — najbliższa droga
  // Subdominanta wymaga zdwojenia prymy: alt → pryma S
  const nextIsSubdom = nc.func === 'S' || nc.func === 's';
  let altChroma;
  if(nextIsSubdom) {
    // Zdwojona pryma — alt idzie na prymę S (chyba że to wspólny dźwięk)
    altChroma = (prev.alt.chroma === commonChroma) ? commonChroma : nc.rootC;
  } else {
    const usedChromas = [nc.rootC, newBass.chroma, newTenor.chroma];
    altChroma = nextChromas.find(c => !usedChromas.includes(c)) ?? nc.rootC;
    if(prev.alt.chroma === commonChroma) altChroma = commonChroma;
  }
  let newAlt = findClosest(altChroma, prev.alt.dia, Math.max(RANGES.alt.min, newTenor.dia+1), RANGES.alt.max);
  if(!newAlt) newAlt = findInRange(altChroma, Math.max(RANGES.alt.min,newTenor.dia+1), RANGES.alt.max, prev.alt.dia);
  
  // 5. Sopran — najbliższa droga
  let sopChroma;
  if(nextIsSubdom) {
    // S zdwojona pryma: sopran może być prymą, tercją lub kwintą
    const usedAll2 = [newBass.chroma, newTenor.chroma, newAlt?.chroma];
    sopChroma = nextChromas.find(c => !usedAll2.includes(c)) ?? nc.fifthC;
    if(prev.sopran.chroma === commonChroma) sopChroma = commonChroma;
  } else {
    const usedAll = [newBass.chroma, newTenor.chroma, newAlt?.chroma];
    sopChroma = nextChromas.find(c => !usedAll.includes(c)) ?? nc.fifthC;
    if(prev.sopran.chroma === commonChroma) sopChroma = commonChroma;
  }
  let newSop = findClosest(sopChroma, prev.sopran.dia, Math.max(RANGES.sopran.min, (newAlt?.dia??0)+1), RANGES.sopran.max);
  if(!newSop) newSop = findInRange(sopChroma, Math.max(RANGES.sopran.min,(newAlt?.dia??0)+1), RANGES.sopran.max, prev.sopran.dia);
  
  const result = {sopran:newSop, alt:newAlt, tenor:newTenor, bass:newBass, chord:nc};
  return validate(result, prev) ? result : leadGeneral(prev, nextChord, layout);
}

// ŁĄCZENIE SEKUNDOWE
function leadSecondal(prev, nextChord, layout) {
  const nc = nextChord;
  
  // Bas idzie o sekundę (w górę lub dół)
  const basMove = prev.bass.dia < findInRange(nc.rootC,RANGES.bass.min,RANGES.bass.max,prev.bass.dia).dia ? 1 : -1;
  const newBass = findInRange(nc.rootC, RANGES.bass.min, RANGES.bass.max, prev.bass.dia + basMove);
  
  // Pozostałe głosy w ruchu przeciwnym do basu
  const dir = -basMove;
  const nextChromas = [nc.rootC, nc.thirdC, nc.fifthC];
  
  const newTenor = findClosest(
    nc.thirdC !== newBass.chroma ? nc.thirdC : nc.rootC,
    prev.tenor.dia + dir,
    Math.max(RANGES.tenor.min, newBass.dia+1), RANGES.tenor.max
  ) ?? findInRange(nc.rootC, Math.max(RANGES.tenor.min,newBass.dia+1), RANGES.tenor.max, prev.tenor.dia+dir);
  
  const newAlt = findClosest(
    nc.fifthC,
    prev.alt.dia + dir,
    Math.max(RANGES.alt.min, (newTenor?.dia??-7)+1), RANGES.alt.max
  ) ?? findInRange(nc.rootC, Math.max(RANGES.alt.min,(newTenor?.dia??-7)+1), RANGES.alt.max, prev.alt.dia+dir);
  
  const newSop = findClosest(
    nc.rootC,
    prev.sopran.dia + dir,
    Math.max(RANGES.sopran.min, (newAlt?.dia??0)+1), RANGES.sopran.max
  ) ?? findInRange(nc.fifthC, Math.max(RANGES.sopran.min,(newAlt?.dia??0)+1), RANGES.sopran.max, prev.sopran.dia+dir);
  
  const result = {sopran:newSop, alt:newAlt, tenor:newTenor, bass:newBass, chord:nc};
  return validate(result, prev) ? result : leadGeneral(prev, nextChord, layout);
}

// POWTÓRZENIE AKORDU — losowy wybór spośród 3 wariantów
function repeatChord(prev, nextChord, layout) {
  // Wariant 0 (bez zmian) rzadziej: 10% szansy, 1 i 2 po 45%
  const r=Math.random(); const variant = r<0.10 ? 0 : r<0.55 ? 1 : 2;
  
  if(variant === 0) {
    // Wariant 1: bez zmiany — wszystko zostaje
    return {
      sopran:{...prev.sopran}, alt:{...prev.alt},
      tenor:{...prev.tenor}, bass:{...prev.bass},
      chord:nextChord
    };
  }
  
  if(variant === 1) {
    // Wariant 2: zmiana układu — sopran zostaje, głosy środkowe zamieniają się
    // skupiony → rozległy: alt i tenor skaczą w dół
    // rozległy → skupiony: alt i tenor skaczą w górę
    const chromas = [nextChord.rootC, nextChord.thirdC, nextChord.fifthC];
    const isSkupiony = (prev.sopran.dia - prev.tenor.dia) <= 7;
    const dir = isSkupiony ? -1 : 1; // skupiony→rozległy: w dół; rozległy→skupiony: w górę
    
    const newTenor = findInRange(prev.alt.chroma,
      Math.max(RANGES.tenor.min, prev.bass.dia+1), RANGES.tenor.max,
      prev.tenor.dia + dir*3);
    const newAlt = findInRange(prev.tenor.chroma,
      Math.max(RANGES.alt.min, (newTenor?.dia??-7)+1), RANGES.alt.max,
      prev.alt.dia + dir*3);
    
    if(!newTenor || !newAlt || newAlt.dia <= newTenor.dia) {
      return {sopran:{...prev.sopran}, alt:{...prev.alt}, tenor:{...prev.tenor}, bass:{...prev.bass}, chord:nextChord};
    }
    return {
      sopran:{...prev.sopran}, alt:newAlt, tenor:newTenor,
      bass:{...prev.bass}, chord:nextChord
    };
  }
  
  // Wariant 3: zmiana pozycji — trzy górne głosy przesuwają się razem o sekundę
  const chromas = [nextChord.rootC, nextChord.thirdC, nextChord.fifthC];
  const dir2 = Math.random() < 0.5 ? 1 : -1; // w górę lub w dół
  
  const newSop = findInRange(prev.sopran.chroma,
    RANGES.sopran.min, RANGES.sopran.max, prev.sopran.dia + dir2);
  const newAlt2 = findInRange(prev.alt.chroma,
    Math.max(RANGES.alt.min, (newSop?.dia??0)-8), (newSop?.dia??12)-1, prev.alt.dia + dir2);
  const newTen2 = findInRange(prev.tenor.chroma,
    Math.max(RANGES.tenor.min, prev.bass.dia+1), Math.min(RANGES.tenor.max,(newAlt2?.dia??5)-1),
    prev.tenor.dia + dir2);
  
  if(!newSop || !newAlt2 || !newTen2 || newSop.dia <= newAlt2.dia || newAlt2.dia <= newTen2.dia) {
    return {sopran:{...prev.sopran}, alt:{...prev.alt}, tenor:{...prev.tenor}, bass:{...prev.bass}, chord:nextChord};
  }
  return {
    sopran:newSop, alt:newAlt2, tenor:newTen2,
    bass:{...prev.bass}, chord:nextChord
  };
}

// OGÓLNE PROWADZENIE (fallback) z weryfikacją zasad
function leadGeneral(prev, nextChord, layout) {
  const nc = nextChord;

  // Bas: ruch do najbliższej prymy
  const newBass = findInRange(nc.rootC, RANGES.bass.min, RANGES.bass.max, prev.bass.dia);

  // Wygeneruj kilka wariantów rozkładu górnych głosów i wybierz najlepszy
  const chromas = [nc.rootC, nc.thirdC, nc.fifthC];
  const upperPerms = [
    [nc.rootC, nc.thirdC, nc.fifthC],
    [nc.thirdC, nc.fifthC, nc.rootC],
    [nc.fifthC, nc.rootC, nc.thirdC],
    [nc.rootC, nc.fifthC, nc.thirdC],
    [nc.thirdC, nc.rootC, nc.fifthC],
    [nc.fifthC, nc.thirdC, nc.rootC],
  ];

  let best = null, bestScore = 9999;
  for(const [tC, aC, sC] of upperPerms) {
    const t = findClosest(tC, prev.tenor.dia, Math.max(RANGES.tenor.min,newBass.dia+1), RANGES.tenor.max);
    if(!t) continue;
    const a = findClosest(aC, prev.alt.dia, Math.max(RANGES.alt.min,t.dia+1), RANGES.alt.max);
    if(!a) continue;
    const s = findClosest(sC, prev.sopran.dia, Math.max(RANGES.sopran.min,a.dia+1), RANGES.sopran.max);
    if(!s) continue;
    const cand = {sopran:s, alt:a, tenor:t, bass:newBass, chord:nc};
    if(!validate(cand, prev)) continue;
    // Punktacja: im mniej problemów tym lepiej
    let score = 0;
    score += Math.abs(s.dia-prev.sopran.dia) + Math.abs(a.dia-prev.alt.dia) + Math.abs(t.dia-prev.tenor.dia);
    if(hasParallels(prev, cand)) score += 50;
    if(allSameDir(prev, cand)) score += 20;
    if(hasAugmentedLeap(prev, cand)) score += 30;
    if(score < bestScore) { bestScore=score; best=cand; }
  }
  return best ?? {sopran:prev.sopran, alt:prev.alt, tenor:prev.tenor, bass:newBass, chord:nc};
}

// ═══════════════════════════════════════════════════
// WALIDACJA
// ═══════════════════════════════════════════════════
function validate(v, prev) {
  if(!v.sopran||!v.alt||!v.tenor||!v.bass) return false;
  if(v.sopran.dia <= v.alt.dia) return false;
  if(v.alt.dia <= v.tenor.dia) return false;
  if(v.tenor.dia <= v.bass.dia) return false;
  return true;
}

// Sprawdź równoległe kwinty i oktawy między dwoma voicingami
function hasParallels(prev, next) {
  const voices = [
    {n:'S', p:prev.sopran, nx:next.sopran},
    {n:'A', p:prev.alt,    nx:next.alt},
    {n:'T', p:prev.tenor,  nx:next.tenor},
    {n:'B', p:prev.bass,   nx:next.bass},
  ];
  const pairs = [[0,1],[0,2],[0,3],[1,2],[1,3],[2,3]];
  for(const [i,j] of pairs) {
    const a=voices[i], b=voices[j];
    if(!a.p||!a.nx||!b.p||!b.nx) continue;
    // Interwał chromatyczny (mod 12)
    const iPrev = ((a.p.chroma  - b.p.chroma)  + 12)%12;
    const iNext = ((a.nx.chroma - b.nx.chroma) + 12)%12;
    // Ruch równoległy (oba w tym samym kierunku)
    const movA = a.nx.dia - a.p.dia;
    const movB = b.nx.dia - b.p.dia;
    if(movA === 0 && movB === 0) continue; // unison ruchu — OK
    const sameDir = (movA > 0 && movB > 0) || (movA < 0 && movB < 0);
    if(!sameDir) continue;
    if(iPrev === iNext && (iNext === 7 || iNext === 5 || iNext === 0)) return true; // kwinta lub oktawa
  }
  return false;
}

// Sprawdź czy wszystkie głosy idą w jednym kierunku
function allSameDir(prev, next) {
  const moves = [
    next.sopran.dia - prev.sopran.dia,
    next.alt.dia    - prev.alt.dia,
    next.tenor.dia  - prev.tenor.dia,
    next.bass.dia   - prev.bass.dia,
  ];
  const up   = moves.filter(m=>m>0).length;
  const down = moves.filter(m=>m<0).length;
  return up === 4 || down === 4;
}

// Sprawdź skoki zwiększone w melodii
function hasAugmentedLeap(prev, next) {
  const pairs = [
    [prev.sopran, next.sopran],
    [prev.alt,    next.alt],
    [prev.tenor,  next.tenor],
    [prev.bass,   next.bass],
  ];
  for(const [p,n] of pairs) {
    if(!p||!n) continue;
    const semis = Math.abs(n.chroma - p.chroma + 12*10) % 12;
    const dias  = Math.abs(n.dia - p.dia);
    // Augmented = dias * 2 < semis (np. zw3 = dias=2, semis=3 → 4<3 nie... zw4=dias=3,semis=6 → 6<6 nie)
    // Zmniejszony: dias * 2 > semis (zm5=dias=4,semis=6 → 8>6 tak)
    // Zwiększony interval: dla danej liczby kroków diatonicznych zbyt dużo półtonów
    if(dias===1 && semis===3) return true; // sekunda zwiększona
    if(dias===3 && semis===6) return true; // kwarta zwiększona (tryton diatoniczny)
    if(dias===4 && semis===6) return true; // kwinta zmniejszona
  }
  return false;
}

function getTimeSig(n) {
  if(n >= 4 && n % 4 === 0) return {num:4, den:4, every:4};
  if(n >= 3 && n % 3 === 0) return {num:3, den:4, every:3};
  if(n >= 2 && n % 2 === 0) return {num:2, den:2, every:2};
  return null;
}

function drawTimeSig(svg, x, tY, bY_row, ts) {
  const fs = '28';
  const ff = 'Poppins,sans-serif';
  const cx = x + 10;  // +10px w prawo
  // Jedno metrum pośrodku między dolną linią treble a górną linią bass
  const yTop    = tY(T_LINE_Y[0]);       // dolna linia wiolinowa
  const yBottom = bY_row(B_LINE_Y[4]);   // górna linia basowa
  const yMid    = (yTop + yBottom) / 2;
  addText(svg, cx, String(Math.round(yMid - 8)),  fs, ff, '#9C8C7C', String(ts.num));
  addText(svg, cx, String(Math.round(yMid + 16)), fs, ff, '#9C8C7C', String(ts.den));
}

function checkErrors(voicings) {
  const errs = [];
  for(let i=1; i<voicings.length; i++) {
    const a = voicings[i-1], b = voicings[i];
    const voices = ['sopran','alt','tenor','bass'];
    voices.forEach(v => {
      if(!a[v]||!b[v]) return;
      const mv = Math.abs(b[v].dia - a[v].dia);
      if(mv >= 6) errs.push(`Skok o septymę lub więcej: ${v} (${mv} stopni)`);
    });
    // Krzyżowanie głosów
    if(b.sopran && b.alt && b.sopran.dia <= b.alt.dia) errs.push('Krzyżowanie: sopran-alt');
    if(b.alt && b.tenor && b.alt.dia <= b.tenor.dia) errs.push('Krzyżowanie: alt-tenor');
    if(b.tenor && b.bass && b.tenor.dia <= b.bass.dia) errs.push('Krzyżowanie: tenor-bas');
  }
  return [...new Set(errs)];
}

